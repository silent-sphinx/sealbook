      "kind": "note",
      "raw": "{\"@type\":\"Note\",\"body\":\"x\",\"createdAt\":\"2026-11-01T00:00:00Z\",\"notebookId\":\"book\",\"parentId\":\"a\",\"title\":\"Plan\",\"updatedAt\":\"2026-11-01T00:00:00Z\",\"version\":\"1.0\",\"x-unknown\":1}",
