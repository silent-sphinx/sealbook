{
  "constants": {
    "calendar_content_type": "application/sealbook.calendar+json",
    "calendar_event_content_type": "application/sealbook.calendar-event+json",
    "calendar_keys": [
      "@type",
      "version",
      "name",
      "color",
      "favorite",
      "archived"
    ],
    "calendar_event_keys": [
      "@type",
      "version",
      "title",
      "start",
      "end",
      "notes",
      "location",
      "participants",
      "timezone",
      "calendarId",
      "recurrence",
      "alerts"
    ],
    "default_calendar_id": "00000000-0000-0000-0000-000000000003",
    "default_calendar_name": "Default Calendar",
    "default_calendar_color": "#7aa2f7",
    "untitled_calendar_name": "Untitled calendar",
    "untitled_event_title": "Untitled event",
    "max_event_alerts": 10,
    "min_alert_minutes_before": -1439,
    "max_alert_minutes_before": 40320,
    "timed_alert_presets": [
      {
        "minutes_before": 10080,
        "label": "1 week before"
      },
      {
        "minutes_before": 2880,
        "label": "2 days before"
      },
      {
        "minutes_before": 1440,
        "label": "1 day before"
      },
      {
        "minutes_before": 120,
        "label": "2 hours before"
      },
      {
        "minutes_before": 60,
        "label": "1 hour before"
      },
      {
        "minutes_before": 30,
        "label": "30 minutes before"
      },
      {
        "minutes_before": 15,
        "label": "15 minutes before"
      },
      {
        "minutes_before": 10,
        "label": "10 minutes before"
      },
      {
        "minutes_before": 5,
        "label": "5 minutes before"
      },
      {
        "minutes_before": 0,
        "label": "At start"
      }
    ],
    "all_day_alert_presets": [
      {
        "minutes_before": 9540,
        "label": "1 week before at 09:00"
      },
      {
        "minutes_before": 2340,
        "label": "2 days before at 09:00"
      },
      {
        "minutes_before": 900,
        "label": "1 day before at 09:00"
      },
      {
        "minutes_before": -540,
        "label": "On the day at 09:00"
