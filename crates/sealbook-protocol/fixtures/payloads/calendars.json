  "calendar_writes": [
    {
      "case": "a calendar created from scratch",
      "draft": {
        "name": "Work",
        "color": "#7aa2f7",
        "favorite": false,
        "archived": false
      },
      "payload": "{\"@type\":\"Calendar\",\"color\":\"#7aa2f7\",\"favorite\":false,\"name\":\"Work\",\"version\":\"1.0\"}"
    },
    {
      "case": "a name with surrounding space, and a favourite",
      "draft": {
        "name": "  Work  ",
        "color": "#7aa2f7",
        "favorite": true,
        "archived": false
      },
      "payload": "{\"@type\":\"Calendar\",\"color\":\"#7aa2f7\",\"favorite\":true,\"name\":\"Work\",\"version\":\"1.0\"}"
    },
    {
      "case": "a blank colour takes the one every client defaults to",
      "draft": {
        "name": "Work",
        "color": "   ",
        "favorite": false,
        "archived": false
      },
      "payload": "{\"@type\":\"Calendar\",\"color\":\"#7aa2f7\",\"favorite\":false,\"name\":\"Work\",\"version\":\"1.0\"}"
    },
    {
      "case": "a calendar put away, which is the only time the key is written",
      "draft": {
        "name": "Old Team",
        "color": "#9ece6a",
        "favorite": false,
        "archived": true
      },
      "payload": "{\"@type\":\"Calendar\",\"archived\":true,\"color\":\"#9ece6a\",\"favorite\":false,\"name\":\"Old Team\",\"version\":\"1.0\"}"
    },
    {
      "case": "a rename that keeps the colour, the flags and a key from a later build",
      "draft": {
        "name": "Renamed",
        "color": "#9ece6a",
        "favorite": true,
        "archived": true,
        "raw": "{\"@type\":\"Calendar\",\"archived\":true,\"color\":\"#9ece6a\",\"favorite\":true,\"name\":\"Old Team\",\"sharedWith\":[\"someone@example.com\"],\"version\":\"1.0\"}"
      },
      "payload": "{\"@type\":\"Calendar\",\"archived\":true,\"color\":\"#9ece6a\",\"favorite\":true,\"name\":\"Renamed\",\"sharedWith\":[\"someone@example.com\"],\"version\":\"1.0\"}"
    },
    {
      "case": "taking a calendar back out of the archive clears the key",
      "draft": {
        "name": "Old Team",
        "color": "#9ece6a",
        "favorite": true,
        "archived": false,
        "raw": "{\"@type\":\"Calendar\",\"archived\":true,\"color\":\"#9ece6a\",\"favorite\":true,\"name\":\"Old Team\",\"sharedWith\":[\"someone@example.com\"],\"version\":\"1.0\"}"
      },
      "payload": "{\"@type\":\"Calendar\",\"color\":\"#9ece6a\",\"favorite\":true,\"name\":\"Old Team\",\"sharedWith\":[\"someone@example.com\"],\"version\":\"1.0\"}"
    }
  ],
